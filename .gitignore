**/bin/
**/target/

# Compiled class file
*.class

# Package Files #
# *.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Eclipse #
**/.externalToolBuilders
**/.polyglot.META-INF

